# ==========================================
# Agentflow_AI Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database & Queues (Defaults to automatic in-memory fallback if not available)
MONGO_URI=mongodb://127.0.0.1:27017/agentflow_ai
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Tokens
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-encryption-secret

# AI LLM Provider Keys (Optional: fallback to deterministic rule engine if blank)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# OAuth 2.0 Integration Credentials (Optional: sandbox simulation mode works out-of-the-box)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/gmail/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/slack/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/discord/callback

GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/google-sheets/callback

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
